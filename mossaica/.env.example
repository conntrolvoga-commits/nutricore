# Sitio
NEXT_PUBLIC_SITE_URL=https://mosaicca.mx

# Supabase (si se omite, la tienda usa el catálogo semilla en src/lib/seed.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (tarjeta, OXXO, SPEI). Sin token -> checkout en modo demo
MP_ACCESS_TOKEN=

# Envia.com (cotización de Estafeta, FedEx, DHL...). Sin token -> tarifas estimadas
ENVIA_API_TOKEN=
ENVIA_ORIGIN_POSTAL_CODE=06600
ENVIA_ORIGIN_STATE=DF
ENVIA_ORIGIN_CITY=Ciudad de Mexico

# Panel /admin
ADMIN_PASSWORD=cambia-esta-clave
