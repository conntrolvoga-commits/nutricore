# Sitio
NEXT_PUBLIC_SITE_URL=https://mosaicca.mx

# Supabase (si se omite, la tienda usa el catálogo semilla en src/lib/seed.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagos. Activa una o las dos pasarelas; con ambas, el cliente elige en el checkout.
# Sin ninguna, el checkout funciona en modo demo (no cobra).
# Mercado Pago (tarjeta, OXXO, SPEI). Webhook: https://TU-DOMINIO/api/webhooks/mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Conekta (tarjeta, OXXO = cash, SPEI = bank_transfer). Webhook: https://TU-DOMINIO/api/webhooks/conekta
CONEKTA_PRIVATE_KEY=
CONEKTA_API_VERSION=1.0

# Envia.com (cotización de Estafeta, FedEx, DHL...). Sin token -> tarifas estimadas
ENVIA_API_TOKEN=
# 'sandbox' usa api-test.envia.com (no cobra guías reales)
ENVIA_ENV=
ENVIA_CARRIERS=estafeta,fedex,dhl
# Origen (tu taller). Para generar guías debe estar completo y real.
ENVIA_ORIGIN_NAME=Mosaicca
ENVIA_ORIGIN_COMPANY=Mosaicca
ENVIA_ORIGIN_EMAIL=
ENVIA_ORIGIN_PHONE=8147902474
ENVIA_ORIGIN_STREET=
ENVIA_ORIGIN_NUMBER=
ENVIA_ORIGIN_DISTRICT=
ENVIA_ORIGIN_CITY=Monterrey
ENVIA_ORIGIN_STATE=NL
ENVIA_ORIGIN_POSTAL_CODE=64000

# Panel /admin
# Mínimo 10 caracteres. Con la clave de ejemplo o una corta el panel se desactiva.
ADMIN_PASSWORD=
