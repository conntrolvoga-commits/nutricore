# Mosaicca · Hostinger (Apache/LiteSpeed)
# IMPORTANTE: activa primero el SSL gratuito en hPanel (Seguridad → SSL); sin SSL, la redirección a HTTPS dará error.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Siempre HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.mosaicca.mx/$1 [L,R=301]
# mosaicca.mx -> www.mosaicca.mx
RewriteCond %{HTTP_HOST} ^mosaicca\.mx$ [NC]
RewriteRule ^(.*)$ https://www.mosaicca.mx/$1 [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
